# Exa — snapshot generation (required for served responses)
EXA_API_KEY=

# x402 payment gate — the payment middleware only mounts when BOTH are set.
# X402_API_KEY is created by a human at https://x402.celo.org (see TASKS T1.4).
X402_API_KEY=
# Seller wallet that receives settlements (its PayTo address is also
# registered with the hackathon entry — x402 settlements carry no tag).
SELLER_PAY_TO=

# Optional: Self verifier network ("mainnet" default, or "testnet"),
# RPC override (e.g. Chainstack), verification timeout.
SELF_AGENT_NETWORK=mainnet
SELF_RPC_URL=
SELF_VERIFY_TIMEOUT_MS=15000

PORT=4021
